APP_NAME=Tomobilti
APP_VERSION=0.1.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Casablanca

# React SPA (CORS allowed origin)
FRONTEND_URL=http://localhost:5173

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL from docker-compose.yml (must match the root .env).
# 127.0.0.1, not localhost: pdo_mysql treats "localhost" as a Unix socket.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=tomobilti
DB_USERNAME=tomobilti
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# Sanctum SPA cookie authentication
SANCTUM_STATEFUL_DOMAINS=localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=localhost

REDIS_CLIENT=phpredis
REDIS_HOST=localhost
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit from docker-compose.yml (web UI: http://localhost:8025)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@tomobilti.ma"
MAIL_FROM_NAME="Tomobilti"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Recipient of the contact form, new reservation requests and client cancellations
AGENCY_EMAIL=contact@tomobilti.ma

# Company details printed on invoices and booking vouchers (config/tomobilti.php).
# The defaults are DEMO values (ICE, RC and IF are all zeros): set the real ones in production.
# COMPANY_NAME="Tomobilti SARL"
# COMPANY_ADDRESS="112, Avenue Mohammed V, Guéliz"
# COMPANY_CITY="40000 Marrakech, Maroc"
# COMPANY_PHONE="+212 5 24 00 01 02"
# COMPANY_EMAIL=contact@tomobilti.ma
# COMPANY_ICE=000000000000000
# COMPANY_RC="Marrakech 000000"
# COMPANY_IF=00000000

# ---------------------------------------------------------------------------
# Production (example for https://tomobilti.ma with the API on https://api.tomobilti.ma)
# Copy these lines over the development values above. Never commit the real .env.
# ---------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false                       # never true: errors would show code and secrets
# APP_URL=https://api.tomobilti.ma
# APP_KEY=                              # php artisan key:generate --show, kept secret
# LOG_LEVEL=warning
# BCRYPT_ROUNDS=12
#
# FRONTEND_URL=https://tomobilti.ma     # CORS allowed origin(s), comma separated, and e-mail links
#
# # Session cookie shared by tomobilti.ma and api.tomobilti.ma, HTTPS only, not sent
# # on cross-site requests. SESSION_DOMAIN starts with a dot to cover both hosts.
# SESSION_DRIVER=database
# SESSION_LIFETIME=120
# SESSION_ENCRYPT=true
# SESSION_DOMAIN=.tomobilti.ma
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# SESSION_HTTP_ONLY=true
#
# # Sanctum: hosts of the SPA that get the session (host[:port], no scheme)
# SANCTUM_STATEFUL_DOMAINS=tomobilti.ma,www.tomobilti.ma
#
# # Database: a dedicated user with a long random password
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=tomobilti
# DB_USERNAME=tomobilti
# DB_PASSWORD=
#
# # Queue worker (Supervisor or systemd): php artisan queue:work --tries=3 --max-time=3600
# # Scheduler (cron, every minute): php artisan schedule:run
# QUEUE_CONNECTION=database
# CACHE_STORE=database
#
# # Mail: a real SMTP relay (smtp, never "log": e-mails carry reset and verification links)
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_HOST=smtp.example.com
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="contact@tomobilti.ma"
# MAIL_FROM_NAME="Tomobilti"
# AGENCY_EMAIL=contact@tomobilti.ma
#
# # Company: the agency's real details, printed on every invoice (required by law)
# COMPANY_NAME="…"
# COMPANY_ADDRESS="…"
# COMPANY_CITY="…"
# COMPANY_PHONE="…"
# COMPANY_EMAIL=…
# COMPANY_WEBSITE=tomobilti.ma
# COMPANY_ICE=…
# COMPANY_RC="…"
# COMPANY_IF=…
