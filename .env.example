# Docker services (docker compose reads this file automatically).
# Copy to .env and change the passwords. Never commit .env.
COMPOSE_PROJECT_NAME=tomobilti

MYSQL_DATABASE=tomobilti
MYSQL_USER=tomobilti
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Host ports (all bound to 127.0.0.1)
MYSQL_PORT=3308
PHPMYADMIN_PORT=8082
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
